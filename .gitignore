# Archivos de credenciales y entorno
.env

# Datos extraídos (pueden ser pesados)
data/

# Reportes generados
# - Excluye los HTML interactivos (~5 MB cada uno, no renderizan en GitHub)
# - Incluye los PNG estáticos para que el profesor pueda verlos directamente
reports/figures/*.html
!reports/figures/
!reports/figures/*.png

# Entorno virtual de Python
venv/
.venv/
env/

# Archivos de caché de Python
__pycache__/
*.py[cod]
*.pyo

# Modelos descargados de HuggingFace (pueden ser muy pesados)
models/

# Checkpoints de entrenamiento
checkpoints/

# Archivos de Jupyter
.ipynb_checkpoints/

# Configuración de IDEs
.vscode/
.idea/
